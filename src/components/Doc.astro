---
import type { CollectionEntry } from 'astro:content';
import { CONTACT } from '../data/contact';

interface Props {
  entry: CollectionEntry<'docs'>;
  path: string;
  release?: string;
}

const { entry, path, release } = Astro.props;
const d = entry.data;
const isThesis = d.kind === 'thesis';

const displayParts =
  isThesis && d.display && d.accent ? d.display.split(d.accent) : null;
---

<section class="doc" id={entry.id} data-doc={entry.id} aria-labelledby={`${entry.id}-title`}>
  {
    isThesis ? (
      <header class="thesis">
        <h1 class="thesis__display" id={`${entry.id}-title`}>
          {displayParts ? (
            <>
              {displayParts[0]}
              <em>{d.accent}</em>
              {displayParts.slice(1).join(d.accent!)}
            </>
          ) : (
            d.display ?? d.title
          )}
        </h1>
      </header>
    ) : (
      <header class="doc__head">
        <div class="doc__path">
          <span class="micro">
            {path.includes('/') ? (
              <>
                {path.split('/')[0]}/<b>{path.split('/').slice(1).join('/')}</b>
              </>
            ) : (
              <b>{path}</b>
            )}
          </span>
          <span class="doc__rule" />
          {release && <span class="micro" style="color:var(--jade)">{release}</span>}
          {d.status === 'private' && <span class="micro">private source</span>}
        </div>
        <h2 class="doc__title" id={`${entry.id}-title`}>{d.title}</h2>
        {d.tagline && <p class="doc__meta">{d.tagline}</p>}
        {(d.role || d.period || d.place) && (
          <p class="doc__meta">
            {d.role && <span>{d.role}</span>}
            {d.period && <span>{d.period}</span>}
            {d.place && <span>{d.place}</span>}
          </p>
        )}
      </header>
    )
  }

  <div class={isThesis ? 'prose thesis__lede' : 'prose'}>
    <slot />
  </div>

  {
    isThesis && (
      <>
        <div class="cta">
          <a
            class="cta__btn cta__btn--go"
            id="cta-book"
            href={CONTACT.booking}
            rel="noopener"
            target="_blank"
          >
            Book a 30-min call
          </a>
          <a class="cta__btn" id="cta-resume" href={CONTACT.resume} download>
            Résumé <span aria-hidden="true">↓</span>
          </a>
          <a class="cta__btn" href={`mailto:${CONTACT.email}`}>
            Email
          </a>
        </div>

        {d.highlights.length > 0 && (
          <p class="hotlinks">
            {d.highlights.map((h) => (
              <a class="hotlink" href={`#${h.doc}`} data-jump={h.doc}>
                {h.label}
                <span class="hotlink__meta">{h.meta}</span>
              </a>
            ))}
          </p>
        )}

        <p class="thesis__hint">
          <span>A review queue — files tick off as you read them.</span>
          <span class="thesis__keys">
            <kbd>?</kbd> keys · <kbd>/</kbd> search · <kbd>b</kbd> book · <kbd>r</kbd> résumé
          </span>
        </p>
      </>
    )
  }

  {
    d.offers.length > 0 && (
      <ol class="offers">
        {d.offers.map((offer, i) => (
          <li class="offer">
            <span class="offer__idx">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="offer__name">{offer.name}</h3>
              <p class="offer__body">{offer.body}</p>
              <p class="offer__proof">{offer.proof}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }

  {
    d.entries.length > 0 && (
      <div class="entries">
        {d.entries.map((item) => (
          <a class="entry" href={item.url} rel="noopener" target="_blank">
            <span class="entry__name">{item.name}</span>
            <span class="entry__meta">{item.meta}</span>
          </a>
        ))}
      </div>
    )
  }

  {
    d.kind === 'contact' && (
      <div class="contact">
        <div class="contact__row">
          <span class="contact__key">Email</span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">Calendar</span>
          <a href={CONTACT.booking} rel="noopener" target="_blank">
            Book a 30-minute intro
          </a>
        </div>
        <div class="contact__row">
          <span class="contact__key">LinkedIn</span>
          <a href={CONTACT.linkedin} rel="noopener" target="_blank">
            linkedin.com/in/ziadalzarka
          </a>
        </div>
        <div class="contact__row">
          <span class="contact__key">GitHub</span>
          <a href={CONTACT.github} rel="noopener" target="_blank">
            github.com/ziadalzarka
          </a>
        </div>
      </div>
    )
  }

  {
    d.stack.length > 0 && (
      <ul class="stack">
        {d.stack.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    )
  }

  {
    d.links.length > 0 && (
      <ul class="links">
        {d.links.map((l) => (
          <li>
            <a
              href={l.href}
              rel={l.href.startsWith('/') ? undefined : 'noopener'}
              target={l.href.startsWith('/') ? undefined : '_blank'}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
