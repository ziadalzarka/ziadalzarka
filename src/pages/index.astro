---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Doc from '../components/Doc.astro';
import Mark from '../components/Mark.astro';
import { getReleases } from '../data/github';
import { CONTACT } from '../data/contact';

const GROUPS = [
  { key: 'root', label: null },
  { key: 'work', label: 'work/' },
  { key: 'ship', label: 'ship/' },
  { key: 'write', label: 'write/' },
  { key: 'hire', label: 'hire/' },
] as const;

const all = await getCollection('docs');

const grouped = GROUPS.map((g) => ({
  ...g,
  items: all
    .filter((e) => e.data.group === g.key)
    .sort((a, b) => a.data.order - b.data.order),
}));

const ordered = grouped.flatMap((g) => g.items);

const rendered = await Promise.all(
  ordered.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const introduction = rendered.filter(({ entry }) => entry.data.kind === 'thesis');
const experience = rendered.filter(({ entry }) => entry.data.group === 'work');
const background = rendered.filter(
  ({ entry }) => entry.data.kind !== 'thesis' && entry.data.group !== 'work'
);

const releases = await getReleases();

const pathFor = (e: (typeof ordered)[number]) =>
  e.data.group === 'root' ? e.data.file : `${e.data.group}/${e.data.file}`;

const releaseFor = (e: (typeof ordered)[number]) => {
  const name = e.data.repo?.split('/')[1];
  return name ? releases[name] : undefined;
};

const KEYS = [
  { keys: 'j  ↓', does: 'next file' },
  { keys: 'k  ↑', does: 'previous file' },
  { keys: '⏎', does: 'open selected' },
  { keys: '/', does: 'search files' },
  { keys: 'g  G', does: 'first · last' },
  { keys: 'b', does: 'book a call' },
  { keys: 'r', does: 'résumé (pdf)' },
  { keys: 'P', does: 'post review' },
  { keys: '?', does: 'this list' },
  { keys: 'esc', does: 'dismiss' },
];

const contactId = ordered.find((e) => e.data.kind === 'contact')?.id ?? '';
---

<Base
  title="Ziad Alzarka - Senior Software Engineer"
  description="Senior software engineer and systems architect. 10 years on data-intensive platforms across finance and medicine — ledgers, reconciliation, medical AI — plus AI agents that do real engineering work. Available for consulting."
>
  <div class="shell">
    <header class="bar bar--top">
      <span class="bar__host"><b>ziad</b>@ziadalzarka.dev</span>
      <span class="micro" id="crumb">readme.md</span>
      <span class="bar__spacer"></span>
      <nav class="chips chips--head" aria-label="Primary actions">
        <a class="chip" href={CONTACT.resume} download>
          Résumé <span aria-hidden="true">↓</span>
        </a>
        <a class="chip chip--go" href={CONTACT.booking} rel="noopener" target="_blank">
          Book a call
        </a>
      </nav>
    </header>

    <div class="body">
      <nav class="rail" aria-label="File tree">
        <form class="rail__search" id="search" hidden role="search">
          <span aria-hidden="true">/</span>
          <input
            type="text"
            id="search-input"
            placeholder="filter files"
            autocomplete="off"
            spellcheck="false"
            aria-label="Filter files"
          />
        </form>

        <div class="tree">
          {
            grouped.map((group, gi) => (
              <div class="tree__group boot" style={`--boot-delay:${60 + gi * 45}ms`}>
                {group.label && <div class="tree__label">{group.label}</div>}
                <ul class="tree__items" role="list">
                  {group.items.map((entry) => (
                    <li>
                      <a class="node" href={`#${entry.id}`} data-node={entry.id}>
                        <Mark />
                        <span class="node__name">{entry.data.file}</span>
                        {entry.data.treeMeta && (
                          <span class="node__meta">{entry.data.treeMeta}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="rail__empty" id="no-match" hidden>no files match</p>
      </nav>

      <main class="pane" id="pane" tabindex="-1">
        <div class="pane__inner">
          {
            introduction.map(({ entry, Content }) => (
              <Doc entry={entry} path={pathFor(entry)} release={releaseFor(entry)}>
                <Content />
              </Doc>
            ))
          }
          <div class="portfolio">
            <div class="portfolio__column" data-column="experience">
              {
                experience.map(({ entry, Content }) => (
                  <Doc entry={entry} path={pathFor(entry)} release={releaseFor(entry)}>
                    <Content />
                  </Doc>
                ))
              }
            </div>
            <div class="portfolio__column" data-column="background">
              {
                background.map(({ entry, Content }) => (
                  <Doc entry={entry} path={pathFor(entry)} release={releaseFor(entry)}>
                    <Content />
                  </Doc>
                ))
              }
            </div>
          </div>
        </div>
      </main>
    </div>

    <footer class="bar bar--bottom">
      <div class="keymap">
        <span><b>j/k</b>move</span>
        <span><b>/</b>search</span>
        <span><b>b</b>book</span>
        <span><b>?</b>keys</span>
      </div>
      <span class="bar__spacer"></span>
      <span class="counter"><b id="read-count">0</b>/{ordered.length} reviewed</span>
      <a class="post" href={`#${contactId}`} id="post">P · post review</a>
      <nav class="chips chips--foot" aria-label="Primary actions">
        <a class="chip" href={CONTACT.resume} download>
          Résumé <span aria-hidden="true">↓</span>
        </a>
        <a class="chip chip--go" href={CONTACT.booking} rel="noopener" target="_blank">
          Book a call
        </a>
      </nav>
    </footer>
  </div>

  <div class="help" id="help" hidden role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
    <div class="help__panel">
      <div class="help__title">
        <span class="micro">keymap</span>
        <span class="micro">esc to close</span>
      </div>
      <ul class="help__list">
        {
          KEYS.map((k) => (
            <li>
              <span class="help__keys">
                {k.keys.split('  ').map((key) => (
                  <kbd>{key}</kbd>
                ))}
              </span>
              <span>{k.does}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <script>
    import '../scripts/tui';
  </script>
</Base>
